# Supabase Connection (Cloud Vector Store)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-o-anon-key

# Ollama Configuration (Local Edge AI on Jetson Orin / Local PC)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma

# Cold Storage SQLite Path (Relative to backend/ or absolute path)
SQLITE_DB_PATH=../consultas_vinculantes.db

# Optional Cloud LLM Generation (Gemini / OpenRouter)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.0-flash-001
